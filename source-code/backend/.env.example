# Cấu hình kết nối cơ sở dữ liệu SQL Server cho Backend
# Sao chép file này thành .env và chỉnh sửa giá trị phù hợp với máy của bạn.

# SQL_SERVER_HOST: 
# - Sử dụng "localhost" nếu bạn dùng SQL Server bản mặc định (Default Instance)
# - Sử dụng "localhost\SQLEXPRESS" nếu bạn dùng SQL Server Express (Named Instance)
SQL_SERVER_HOST=localhost

# Tên cơ sở dữ liệu của dự án
SQL_SERVER_DB=HorseRacing
